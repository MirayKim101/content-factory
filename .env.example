# Local development only. Copy this file to .env and replace every value before
# starting Docker Compose. The real .env is ignored by Git.

# Explicit local-only shortcut. Production must use "other" + "manual".
DEPLOYMENT_PROFILE=local
SOURCE_AUTHORIZATION_POLICY=local-auto
API_HOST=127.0.0.1

POSTGRES_DB=content_factory
POSTGRES_USER=content_factory
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_LOCAL_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_LOCAL_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Root is consumed only by MinIO itself and the one-shot provisioning service.
MINIO_ROOT_USER=content-factory-local
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_LOCAL_PASSWORD

# API and private S3 storage. Defaults are shown explicitly for reproducibility.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_SOURCE_BUCKET=content-factory-sources
# API receives only this bucket/prefix-scoped identity.
S3_ACCESS_KEY=content-factory-api
S3_SECRET_KEY=CHANGE_ME_API_S3_LOCAL_PASSWORD
S3_OPERATION_TIMEOUT_MS=7200000
S3_STARTUP_TIMEOUT_MS=5000
API_MAX_UPLOAD_BYTES=10737418240
API_UPLOAD_TEMP_DIRECTORY=tmp/uploads
API_UPLOAD_TEMP_STALE_AFTER_MS=300000
API_UPLOAD_TEMP_SWEEP_LIMIT=100
SOURCE_PENDING_STALE_AFTER_MS=300000
SOURCE_PENDING_RECONCILE_LIMIT=25
SOURCE_PENDING_STARTUP_TIMEOUT_MS=5000
MEDIA_RECONCILE_INTERVAL_MS=5000
MEDIA_RECONCILE_LIMIT=100
# Optional queue namespace. Keep the default in normal local/runtime processes;
# integration tests use a unique value so a live worker cannot consume test jobs.
MEDIA_QUEUE_NAME=media-v1
# Local MVP admission switch. Keep 0/non-local until the capable worker is deployed.
ASSEMBLY_RENDER_ENABLED=1
EDITORIAL_APPROVAL_ENABLED=1
# Keep export admission off until the Stage 2e worker/API diff has independent CLEAN review.
EDITORIAL_EXPORT_ENABLED=0
# Keep creator-context mutations off until the Stage 2B-1 migration, API and UI
# have independent CLEAN reviews. Manual Stage 2 remains available while off.
AI_CONTEXT_ENABLED=0
RESEARCH_TEXT_ENABLED=0
THUMBNAIL_SUGGESTIONS_ENABLED=0
# Sparse-frame admission is an API-only switch; keep it off until the capable
# worker, storage policy, migration and independent runtime review are ready.
EDITORIAL_FRAMES_ENABLED=0
# Master admission and worker switch. Keep it off until at least the local
# dry-run rollout is explicitly enabled in both API and publication worker.
PUBLISHING_ENABLED=0
# Required only when a real external publication adapter is enabled. Each value
# is a version plus one standard-base64 32-byte AES key. Retain old keys while
# resumable sessions encrypted with them may still exist; never commit real keys.
# PUBLICATION_SESSION_CURRENT_KEY_VERSION=v1
# PUBLICATION_SESSION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY
# YouTube stays fail-closed until all values below are provided to both API and
# publication worker. Credentials bind to a verified YouTube UC... identity;
# an optional channelId can narrow them to one application channel UUID.
YOUTUBE_PUBLISHING_ENABLED=0
# YOUTUBE_OAUTH_CLIENT_ID=REPLACE_ME
# YOUTUBE_OAUTH_CLIENT_SECRET=REPLACE_ME
# YOUTUBE_CHANNEL_CREDENTIALS_JSON=[{"externalChannelRef":"UC...","refreshToken":"REPLACE_ME"}]
# TikTok also stays default-off. Enabling it additionally requires the API
# consent flow to present fresh creator_info capabilities and persist explicit
# user choices before an intent is admitted.
TIKTOK_PUBLISHING_ENABLED=0
# TIKTOK_CLIENT_KEY=REPLACE_ME
# TIKTOK_CLIENT_SECRET=REPLACE_ME
# TIKTOK_CHANNEL_CREDENTIALS_JSON=[{"externalChannelRef":"OPEN_ID","refreshToken":"REPLACE_ME"}]
MEDIA_WORKER_CONCURRENCY=1
# One durable cross-replica frame-extraction slot in local MVP runtime.
FRAME_EXTRACTION_CAPACITY=1
# Five-minute default; a controlled recovery test may set a validated 60000 ms.
FRAME_WORK_DEADLINE_MS=300000
MEDIA_JOB_LEASE_MS=30000
MEDIA_JOB_TIMEOUT_MS=7200000
MEDIA_SCRATCH_DIRECTORY=tmp/media-worker
MEDIA_SCRATCH_SAFETY_MIB=1024
# Worker-local, process-lifetime source cache. Keep this below the tmpfs limit
# with room for one result, one in-flight fill, and the safety reserve.
MEDIA_SOURCE_CACHE_DIRECTORY=tmp/media-cache
MEDIA_SOURCE_CACHE_MAX_MIB=12288
MEDIA_SOURCE_CACHE_TTL_MS=21600000
# Docker Compose mounts an ephemeral tmpfs of this maximum size for the worker.
# Source and result media remain persistent only in the private S3 bucket.
MEDIA_SCRATCH_SIZE=24g
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# One assembly uses at most this many FFmpeg threads. Keep 2 while the local
# heavy-job pool remains at concurrency 1; raise only after a measured benchmark.
FFMPEG_THREADS=2
# Required deterministic UTF-8 CTA font, pinned inside the worker image.
ASSEMBLY_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TWITCH_INGESTION_ENABLED=0
# Separate kill switch for API admission and media transfer. Both this and the
# gateway flag must be 1 before a VOD can leave READY_FOR_INGEST.
TWITCH_VOD_AUTO_INGEST_ENABLED=0
TWITCH_VOD_MEDIA_GATEWAY_ENABLED=0
TWITCH_VOD_MEDIA_GATEWAY_BASE_URL=
TWITCH_VOD_MEDIA_GATEWAY_TOKEN=
TWITCH_VOD_MEDIA_REQUEST_TIMEOUT_MS=30000
# Hard persisted-byte limit per VOD (default 100 GiB).
TWITCH_VOD_MAX_BYTES=107374182400
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_APP_ACCESS_TOKEN=
# Production only: exact public HTTPS:443 endpoint ending in /api/v1/twitch/eventsub.
TWITCH_EVENTSUB_CALLBACK_URL=
TWITCH_EVENTSUB_SECRET=
# Master admission and worker switch for the separate 9:16 render profile.
# Existing vertical history remains readable while this is off.
VERTICAL_RENDER_ENABLED=0
# AI timestamp suggestions. Keep disabled until an approved provider model and
# secret are configured; manual cuts remain available while disabled.
CLIP_GENERATION_ENABLED=0
CLIP_GENERATION_PROVIDER=OPENAI
CLIP_GENERATION_MODEL=
CLIP_GENERATION_TIMEOUT_MS=120000
OPENAI_API_KEY=
# Optional HTTPS provider-compatible endpoint. Local HTTP loopback is accepted
# only under DEPLOYMENT_PROFILE=local.
OPENAI_BASE_URL=
