# Local development only. Copy this file to .env and replace every value before
# starting Docker Compose. The real .env is ignored by Git.

# Explicit local-only shortcut. Production must use "other" + "manual".
DEPLOYMENT_PROFILE=local
SOURCE_AUTHORIZATION_POLICY=local-auto
API_HOST=127.0.0.1

POSTGRES_DB=content_factory
POSTGRES_USER=content_factory
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_LOCAL_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_LOCAL_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Root is consumed only by MinIO itself and the one-shot provisioning service.
MINIO_ROOT_USER=content-factory-local
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_LOCAL_PASSWORD

# API and private S3 storage. Defaults are shown explicitly for reproducibility.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_SOURCE_BUCKET=content-factory-sources
# API receives only this bucket/prefix-scoped identity.
S3_ACCESS_KEY=content-factory-api
S3_SECRET_KEY=CHANGE_ME_API_S3_LOCAL_PASSWORD
S3_OPERATION_TIMEOUT_MS=7200000
S3_STARTUP_TIMEOUT_MS=5000
API_MAX_UPLOAD_BYTES=10737418240
API_UPLOAD_TEMP_DIRECTORY=tmp/uploads
API_UPLOAD_TEMP_STALE_AFTER_MS=300000
API_UPLOAD_TEMP_SWEEP_LIMIT=100
SOURCE_PENDING_STALE_AFTER_MS=300000
SOURCE_PENDING_RECONCILE_LIMIT=25
SOURCE_PENDING_STARTUP_TIMEOUT_MS=5000
MEDIA_RECONCILE_INTERVAL_MS=5000
MEDIA_RECONCILE_LIMIT=100
# Optional queue namespace. Keep the default in normal local/runtime processes;
# integration tests use a unique value so a live worker cannot consume test jobs.
MEDIA_QUEUE_NAME=media-v1
# Local MVP admission switch. Keep 0/non-local until the capable worker is deployed.
ASSEMBLY_RENDER_ENABLED=1
EDITORIAL_APPROVAL_ENABLED=1
# Keep export admission off until the Stage 2e worker/API diff has independent CLEAN review.
EDITORIAL_EXPORT_ENABLED=0
MEDIA_WORKER_CONCURRENCY=1
MEDIA_JOB_LEASE_MS=30000
MEDIA_JOB_TIMEOUT_MS=7200000
MEDIA_SCRATCH_DIRECTORY=tmp/media-worker
MEDIA_SCRATCH_SAFETY_MIB=1024
# Worker-local, process-lifetime source cache. Keep this below the tmpfs limit
# with room for one result, one in-flight fill, and the safety reserve.
MEDIA_SOURCE_CACHE_DIRECTORY=tmp/media-cache
MEDIA_SOURCE_CACHE_MAX_MIB=12288
MEDIA_SOURCE_CACHE_TTL_MS=21600000
# Docker Compose mounts an ephemeral tmpfs of this maximum size for the worker.
# Source and result media remain persistent only in the private S3 bucket.
MEDIA_SCRATCH_SIZE=24g
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# One assembly uses at most this many FFmpeg threads. Keep 2 while the local
# heavy-job pool remains at concurrency 1; raise only after a measured benchmark.
FFMPEG_THREADS=2
# Required deterministic UTF-8 CTA font, pinned inside the worker image.
ASSEMBLY_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
