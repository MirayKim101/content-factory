  @@unique([jobId, clientSegmentId])
}

model JobAttempt {
  id                   String                @id @db.Uuid
  jobId                String                @db.Uuid
  job                  PipelineJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber        Int
  state                JobAttemptState       @default(QUEUED)
  workerId             String?
  leaseToken           String?
  startedAt            DateTime?
  heartbeatAt          DateTime?
  finishedAt           DateTime?
  failureCode          String?
  outputObjectKey      String?               @unique
  cleanupStatus        ArtifactCleanupStatus @default(NOT_REQUIRED)
  cleanupAttemptCount  Int                   @default(0)
  cleanupLastErrorCode String?
  cleanupRequestedAt   DateTime?
  cleanupCompletedAt   DateTime?
  scratchDirectoryName String?               @unique
  scratchLeaseHash     String?
  scratchReservedBytes BigInt?
  scratchCreatedAt     DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([jobId, attemptNumber])
  @@index([state, updatedAt])
  @@index([cleanupStatus, updatedAt])
}

model CreatorProfile {
