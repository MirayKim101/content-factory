generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  SOURCE_PENDING
  SOURCE_READY
  FAILED_FINAL
}

enum VideoSourceStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum MediaArtifactStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum MediaArtifactRole {
  SOURCE
  HORIZONTAL_CUT
}

enum ArtifactCleanupStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
}

enum SourceAuthorizationStatus {
  NOT_REVIEWED
  CLEARED
}

enum SourceAuthorizationBasis {
  EXPLICIT_CONFIRMATION
  LEGACY_ATTESTATION
}

enum PipelineJobType {
  HORIZONTAL_CUT
}

enum PipelineJobState {
  QUEUED
  RUNNING
  FAILED_RETRYABLE
  SUCCEEDED
  FAILED_FINAL
}

enum JobAttemptState {
  RUNNING
  FAILED_RETRYABLE
  FAILED_FINAL
  SUCCEEDED
  ABANDONED
}

model Project {
  id                       String          @id @db.Uuid
  idempotencyKey           String          @unique
  requestFingerprint       String
  name                     String
  status                   ProjectStatus   @default(SOURCE_PENDING)
  rightsConfirmedAt        DateTime?
  rightsDeclarationVersion String?
  failureCode              String?
  failureMessage           String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  source                   VideoSource?
  artifacts                MediaArtifact[]
  pipelineJobs             PipelineJob[]
}

model VideoSource {
  id               String                @id @db.Uuid
  projectId        String                @unique @db.Uuid
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           VideoSourceStatus     @default(PENDING)
  sourceVersion    Int                   @default(1)
  originalFilename String
  contentType      String
  sizeBytes        BigInt
  sha256           String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  artifacts        MediaArtifact[]
  authorizations   SourceAuthorization[]
  pipelineJobs     PipelineJob[]
}

model SourceAuthorization {
  sourceId           String                    @db.Uuid
  source             VideoSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion      Int
  sourceSha256       String                    @db.Char(64)
  status             SourceAuthorizationStatus @default(NOT_REVIEWED)
  basis              SourceAuthorizationBasis?
  confirmedAt        DateTime?
  declarationVersion String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@id([sourceId, sourceVersion])
  @@index([sourceId, sourceVersion, sourceSha256, status], map: "SourceAuthorization_exact_clearance_idx")
}

model MediaArtifact {
  id                   String                @id @db.Uuid
  projectId            String                @db.Uuid
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId             String                @db.Uuid
  source               VideoSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  role                 MediaArtifactRole
  status               MediaArtifactStatus   @default(PENDING)
  objectKey            String                @unique
  storageEtag          String?
  storageVersion       String?
  cleanupStatus        ArtifactCleanupStatus @default(NOT_REQUIRED)
  cleanupAttemptCount  Int                   @default(0)
  cleanupLastErrorCode String?
  cleanupRequestedAt   DateTime?
  cleanupCompletedAt   DateTime?
  sizeBytes            BigInt
  sha256               String
  contentType          String
  lineageSourceId      String                @db.Uuid
  lineageSourceVersion Int
  recipeVersion        String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  winningForJob        PipelineJob?          @relation("WinningArtifact")

  @@index([status, createdAt])
  @@index([cleanupStatus, updatedAt])
}

model PipelineJob {
  id                  String           @id @db.Uuid
  projectId           String           @db.Uuid
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId            String           @db.Uuid
  source              VideoSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  type                PipelineJobType
  state               PipelineJobState @default(QUEUED)
  sourceVersion       Int
  sourceSha256        String           @db.Char(64)
  startMs             Int
  endMs               Int
  recipeVersion       String
  idempotencyKey      String
  requestFingerprint  String
  revision            Int              @default(0)
  maxAttempts         Int              @default(3)
  attemptCount        Int              @default(0)
  currentAttemptId    String?          @db.Uuid
  nextAttemptAt       DateTime         @default(now())
  admissionDeadlineAt DateTime
  stage               String           @default("QUEUED")
  progressCurrent     BigInt?
  progressTotal       BigInt?
  progressUnit        String?
  queueReason         String?
  failureCode         String?
  failureMessage      String?
  winningArtifactId   String?          @unique @db.Uuid
  winningArtifact     MediaArtifact?   @relation("WinningArtifact", fields: [winningArtifactId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  attempts            JobAttempt[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt, id])
  @@index([state, nextAttemptAt])
}

model JobAttempt {
  id                       String                @id @db.Uuid
  jobId                    String                @db.Uuid
  job                      PipelineJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber            Int
  state                    JobAttemptState       @default(RUNNING)
  claimRevision            Int
  leaseToken               String                @unique @db.Uuid
  startedAt                DateTime              @default(now())
  heartbeatAt              DateTime
  leaseExpiresAt           DateTime
  finishedAt               DateTime?
  reservedScratchBytes     BigInt
  failureCode              String?
  failureMessage           String?
  outputObjectKey          String?               @unique
  outputCleanupStatus      ArtifactCleanupStatus @default(NOT_REQUIRED)
  outputCleanupAttempts    Int                   @default(0)
  outputCleanupLastError   String?
  outputCleanupRequestedAt DateTime?
  outputCleanupCompletedAt DateTime?

  @@unique([jobId, attemptNumber])
  @@index([state, leaseExpiresAt])
  @@index([outputCleanupStatus, outputCleanupRequestedAt])
}
