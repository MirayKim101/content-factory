  defaultReferenceAuthorizationRevision   Int?
  defaultReferenceAuthorization           CreatorReferenceAuthorizationRevision? @relation("CreatorProfileDefaultReferenceAuthorization", fields: [defaultReferenceAuthorizationRevisionId, defaultReferenceAssetId, defaultReferenceAuthorizationRevision], references: [id, referenceAssetId, revision], onDelete: Restrict, map: "CreatorProfileRevision_exact_default_authorization")
  createdAt                               DateTime                               @default(now())
  sourceContexts                          SourceEditorialContextRevision[]

  @@unique([creatorProfileId, revision], map: "CreatorProfileRevision_profile_revision_key")
