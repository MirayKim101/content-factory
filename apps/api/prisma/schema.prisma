  @@unique([id, projectId], map: "EditorialApproval_id_projectId_key")
  @@unique([id, projectId, sourceId, sourceVersion, cutPipelineJobId, candidateFingerprint, editorialPackageRevisionId, recipeRevisionId, assemblyRenderResultId], map: "EditorialApproval_export_snapshot_key")
  @@index([projectId, approvedAt, id])
  @@index([cutPipelineJobId, approvedAt, id])
}

