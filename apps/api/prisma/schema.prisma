generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  SOURCE_PENDING
  SOURCE_READY
  FAILED_FINAL
}

enum VideoSourceStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum MediaArtifactStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum MediaArtifactRole {
  SOURCE
  CUT_RESULT
  HORIZONTAL_ASSEMBLY_RESULT
  EDITORIAL_EXPORT_PACKAGE
}

enum PipelineJobType {
  SOURCE_PROBE
  CUT_SEGMENT
  MONTAGE_ASSET_PROBE
  ASSEMBLE_HORIZONTAL
  EXPORT_EDITORIAL_PACKAGE
}

enum AssemblyProgressPhase {
  DOWNLOAD
  READ_INPUTS
  WRITE_ARCHIVE
  AUDIO_ANALYSIS
  ENCODE
  OUTPUT_PROBE
  OUTPUT_HASH
  UPLOAD
  FINALIZE
}

enum MontageAssetKind {
  ADVERTISEMENT
  INTRO
  OUTRO
  BANNER
}

enum MontageAssetStatus {
  UPLOADING
  PROBE_PENDING
  READY
  FAILED_FINAL
}

enum AssemblyAssetRole {
  INTRO
  OUTRO
  ADVERTISEMENT
  BANNER
}

enum AssemblyOverlayPosition {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

enum PipelineJobState {
  QUEUED
  PROCESSING
  RETRY_WAIT
  READY
  FAILED_FINAL
}

enum JobAttemptState {
  QUEUED
  PROCESSING
  FAILED_RETRYABLE
  READY
  FAILED_FINAL
}

enum ArtifactCleanupStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
}

enum SourceAuthorizationStatus {
  NOT_REVIEWED
  CLEARED
}

enum SourceAuthorizationBasis {
  LEGACY_ATTESTATION
  OPERATOR_ATTESTATION
  LOCAL_DEVELOPMENT_AUTO
}

enum EditorialAssetType {
  THUMBNAIL
}

enum EditorialAssetStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum EditorialOperationType {
  CREATE_EDITORIAL_APPROVAL
  CREATE_EDITORIAL_EXPORT
}

enum CreatorLikenessPolicy {
  NO_REALISTIC_LIKENESS
  CLEARED_REFERENCE_ONLY
}

enum CreatorReferenceAssetStatus {
  PENDING
  READY
  FAILED_FINAL
}

enum CreatorReferenceAuthorizationStatus {
  NOT_REVIEWED
  CLEARED
  REVOKED
}

enum AiContentOperationType {
  CREATE_CREATOR_PROFILE
  UPDATE_CREATOR_PROFILE
  UPLOAD_CREATOR_REFERENCE
  UPDATE_CREATOR_REFERENCE_AUTHORIZATION
  SET_DEFAULT_CREATOR_REFERENCE
  PUT_SOURCE_EDITORIAL_CONTEXT
  PUT_CUT_EDITORIAL_PROMPT
}

enum EditorialComponentType {
  METADATA
  THUMBNAIL
}

enum EditorialProvenanceMode {
  MANUAL
  AI_ASSISTED
  MIXED
}

model Project {
  id                         String                      @id @db.Uuid
  idempotencyKey             String                      @unique
  requestFingerprint         String
  name                       String
  status                     ProjectStatus               @default(SOURCE_PENDING)
  rightsConfirmedAt          DateTime?
  rightsDeclarationVersion   String?
  failureCode                String?
  failureMessage             String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  source                     VideoSource?
  artifacts                  MediaArtifact[]
  cutRequests                CutRequest[]
  pipelineJobs               PipelineJob[]
  editorialAssets            EditorialAsset[]
  editorialPackages          EditorialPackage[]
  montageAssets              MontageAsset[]
  assemblyRecipes            AssemblyRecipe[]
  assemblyRenderIntents      AssemblyRenderIntent[]
  editorialApprovals         EditorialApproval[]
  editorialOperationRequests EditorialOperationRequest[]
  editorialExportIntents     EditorialExportIntent[]
  sourceEditorialContexts    SourceEditorialContext[]
}

model VideoSource {
  id                      String                   @id @db.Uuid
  projectId               String                   @unique @db.Uuid
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                  VideoSourceStatus        @default(PENDING)
  sourceVersion           Int                      @default(1)
  originalFilename        String
  contentType             String
  sizeBytes               BigInt
  sha256                  String
  durationMs              Int?
  probedAt                DateTime?
  probeVersion            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  artifacts               MediaArtifact[]
  pipelineJobs            PipelineJob[]
  authorizations          SourceAuthorization[]
  montageAssets           MontageAsset[]
  assemblyRenderIntents   AssemblyRenderIntent[]
  editorialApprovals      EditorialApproval[]
  editorialExportIntents  EditorialExportIntent[]
  sourceEditorialContexts SourceEditorialContext[]

  @@unique([id, projectId, sourceVersion], map: "VideoSource_ai_exact_source_key")
}

model SourceAuthorization {
  sourceId           String
  sourceVersion      Int
  source             VideoSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status             SourceAuthorizationStatus @default(NOT_REVIEWED)
  basis              SourceAuthorizationBasis?
  declarationVersion String?
  decidedAt          DateTime?
  revision           Int                       @default(1)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@id([sourceId, sourceVersion])
  @@unique([sourceId, sourceVersion])
  @@index([status, updatedAt])
}

model MediaArtifact {
  id                    String                 @id @db.Uuid
  projectId             String                 @db.Uuid
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId              String                 @db.Uuid
  source                VideoSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  role                  MediaArtifactRole
  status                MediaArtifactStatus    @default(PENDING)
  objectKey             String                 @unique
  storageEtag           String?
  storageVersion        String?
  cleanupStatus         ArtifactCleanupStatus  @default(NOT_REQUIRED)
  cleanupAttemptCount   Int                    @default(0)
  cleanupLastErrorCode  String?
  cleanupRequestedAt    DateTime?
  cleanupCompletedAt    DateTime?
  sizeBytes             BigInt
  sha256                String
  contentType           String
  lineageSourceId       String                 @db.Uuid
  lineageSourceVersion  Int
  recipeVersion         String
  pipelineJobId         String?                @unique @db.Uuid
  pipelineJob           PipelineJob?           @relation("PipelineJobResult", fields: [pipelineJobId], references: [id], onDelete: SetNull)
  ffmpegVersion         String?
  outputFilename        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  editorialPackage      EditorialPackage?
  assemblyRecipe        AssemblyRecipe?
  assemblyRenderInputs  AssemblyRenderIntent[]
  assemblyRenderResult  AssemblyRenderResult?
  editorialApprovals    EditorialApproval[]
  editorialExportResult EditorialExportResult?
  cutEditorialPrompt    CutEditorialPrompt?

  @@unique([id, projectId, lineageSourceId, lineageSourceVersion, pipelineJobId], map: "MediaArtifact_id_projectId_lineage_pipelineJob_key")
  @@index([status, createdAt])
  @@index([cleanupStatus, updatedAt])
}

model CutRequest {
  id                 String        @id @db.Uuid
  projectId          String        @db.Uuid
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey     String        @unique
  requestFingerprint String
  createdAt          DateTime      @default(now())
  jobs               PipelineJob[]

  @@index([projectId, createdAt])
}

model PipelineJob {
  id                      String                 @id @db.Uuid
  projectId               String                 @db.Uuid
  project                 Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId                String                 @db.Uuid
  source                  VideoSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion           Int
  cutRequestId            String?                @db.Uuid
  cutRequest              CutRequest?            @relation(fields: [cutRequestId], references: [id], onDelete: Cascade)
  type                    PipelineJobType
  state                   PipelineJobState       @default(QUEUED)
  payloadVersion          Int                    @default(1)
  idempotencyKey          String                 @unique
  revision                Int                    @default(1)
  priority                Int                    @default(0)
  retryBudget             Int                    @default(2)
  attemptCount            Int                    @default(0)
  processedMs             Int?
  totalMs                 Int?
  leaseOwner              String?
  leaseToken              String?                @unique
  leaseExpiresAt          DateTime?
  heartbeatAt             DateTime?
  failureCode             String?
  failureMessage          String?
  failureRetryable        Boolean?
  recipeVersion           String
  queuedAt                DateTime               @default(now())
  startedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  segment                 CutSegment?
  attempts                JobAttempt[]
  resultArtifact          MediaArtifact?         @relation("PipelineJobResult")
  editorialPackage        EditorialPackage?
  assemblyRecipe          AssemblyRecipe?
  montageAssetId          String?                @unique @db.Uuid
  montageAsset            MontageAsset?          @relation(fields: [montageAssetId], references: [id], onDelete: Restrict)
  assemblyRenderIntentId  String?                @unique @db.Uuid
  assemblyRenderIntent    AssemblyRenderIntent?  @relation("AssemblyRenderJob", fields: [assemblyRenderIntentId, projectId, sourceId, sourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "PipelineJob_exact_assembly_intent")
  assemblyRenderInputs    AssemblyRenderIntent[] @relation("AssemblyRenderCutJob")
  editorialApprovals      EditorialApproval[]
  editorialExportIntentId String?                @unique @db.Uuid
  editorialExportIntent   EditorialExportIntent? @relation("EditorialExportJob", fields: [editorialExportIntentId, projectId, sourceId, sourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "PipelineJob_exact_editorial_export_intent")
  editorialExportResult   EditorialExportResult?
  cutEditorialPrompt      CutEditorialPrompt?
  nextAttemptAt           DateTime?
  admissionReason         String?
  progressAttemptNumber   Int?
  progressPhase           AssemblyProgressPhase?
  progressBasisPoints     Int?
  progressUpdatedAt       DateTime?

  @@unique([id, projectId, sourceId, sourceVersion])
  @@unique([assemblyRenderIntentId, projectId, sourceId, sourceVersion], map: "PipelineJob_assembly_intent_lineage_key")
  @@unique([editorialExportIntentId, projectId, sourceId, sourceVersion], map: "PipelineJob_editorial_export_intent_lineage_key")
  @@index([state, type, priority, queuedAt])
  @@index([leaseExpiresAt])
  @@index([projectId, createdAt])
  @@index([sourceId, sourceVersion])
}

model MontageAsset {
  id                   String                         @id @db.Uuid
  projectId            String                         @db.Uuid
  project              Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceId             String                         @db.Uuid
  source               VideoSource                    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion        Int
  kind                 MontageAssetKind
  status               MontageAssetStatus             @default(UPLOADING)
  revision             Int                            @default(1)
  idempotencyKey       String                         @unique
  requestFingerprint   String
  objectKey            String                         @unique
  originalFilename     String
  contentType          String
  sizeBytes            BigInt
  sha256               String
  width                Int?
  height               Int?
  durationMs           Int?
  hasAudio             Boolean?
  probeVersion         String?
  probedAt             DateTime?
  rightsBasis          String
  rightsDeclaration    String
  rightsDecidedAt      DateTime
  uploadExpiresAt      DateTime
  storageEtag          String?
  storageVersion       String?
  failureCode          String?
  failureMessage       String?
  cleanupStatus        ArtifactCleanupStatus          @default(NOT_REQUIRED)
  cleanupAttemptCount  Int                            @default(0)
  cleanupLastErrorCode String?
  cleanupCompletedAt   DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  probeJob             PipelineJob?
  assemblyReferences   AssemblyRecipeAssetReference[]

  @@unique([id, projectId, sourceId, sourceVersion])
  @@index([projectId, kind, createdAt, id])
  @@index([status, uploadExpiresAt])
  @@index([cleanupStatus, updatedAt])
}

model AssemblyRecipe {
  id                     String                   @id @db.Uuid
  projectId              String                   @db.Uuid
  project                Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pipelineJobId          String                   @unique @db.Uuid
  pipelineJob            PipelineJob              @relation(fields: [pipelineJobId, projectId, lineageSourceId, lineageSourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "AssemblyRecipe_exact_job_lineage")
  cutResultArtifactId    String                   @unique @db.Uuid
  cutResultArtifact      MediaArtifact            @relation(fields: [cutResultArtifactId, projectId, lineageSourceId, lineageSourceVersion, pipelineJobId], references: [id, projectId, lineageSourceId, lineageSourceVersion, pipelineJobId], onDelete: Restrict, map: "AssemblyRecipe_exact_artifact_lineage")
  cutResultSha256        String
  cutResultSizeBytes     BigInt
  cutResultRecipeVersion String
  lineageSourceId        String                   @db.Uuid
  lineageSourceVersion   Int
  cutDurationMs          Int
  currentRevision        Int
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  revisions              AssemblyRecipeRevision[]
  renderIntents          AssemblyRenderIntent[]
  editorialApprovals     EditorialApproval[]

  @@unique([pipelineJobId, projectId, lineageSourceId, lineageSourceVersion], map: "AssemblyRecipe_pipeline_exact_key")
  @@unique([cutResultArtifactId, projectId, lineageSourceId, lineageSourceVersion, pipelineJobId], map: "AssemblyRecipe_artifact_exact_key")
  @@index([projectId, updatedAt, id])
}

model AssemblyRecipeRevision {
  id                       String                          @id @db.Uuid
  recipeId                 String                          @db.Uuid
  recipe                   AssemblyRecipe                  @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  revision                 Int
  schemaVersion            String                          @default("horizontal-assembly-v1")
  configurationFingerprint String
  audioProfileVersion      String                          @default("youtube-stereo-v1")
  encodingProfileVersion   String                          @default("youtube-h264-v1")
  advertisementInsertAtMs  Int?
  ctaText                  String?
  ctaStartMs               Int?
  ctaEndMs                 Int?
  ctaPosition              AssemblyOverlayPosition?
  createdAt                DateTime                        @default(now())
  assetReferences          AssemblyRecipeAssetReference[]
  mutationRequests         AssemblyRecipeMutationRequest[]
  renderIntents            AssemblyRenderIntent[]
  editorialApprovals       EditorialApproval[]
  editorialExportIntents   EditorialExportIntent[]

  @@unique([recipeId, revision], map: "AssemblyRecipeRevision_recipe_revision_key")
  @@unique([id, recipeId, revision], map: "AssemblyRecipeRevision_exact_identity_key")
  @@index([createdAt, id])
}

model AssemblyRecipeAssetReference {
  id               String                   @id @db.Uuid
  recipeRevisionId String                   @db.Uuid
  recipeRevision   AssemblyRecipeRevision   @relation(fields: [recipeRevisionId], references: [id], onDelete: Restrict)
  role             AssemblyAssetRole
  ordinal          Int
  assetId          String                   @db.Uuid
  asset            MontageAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetRevision    Int
  assetSha256      String
  assetSizeBytes   BigInt
  assetKind        MontageAssetKind
  assetDurationMs  Int?
  clientItemId     String?
  startMs          Int?
  endMs            Int?
  position         AssemblyOverlayPosition?
  createdAt        DateTime                 @default(now())

  @@unique([recipeRevisionId, role, ordinal], map: "AssemblyRecipeAssetReference_role_ordinal_key")
  @@index([assetId])
}

model AssemblyRecipeMutationRequest {
  id                 String                 @id @db.Uuid
  idempotencyKey     String                 @unique
  requestFingerprint String
  recipeRevisionId   String                 @db.Uuid
  recipeRevision     AssemblyRecipeRevision @relation(fields: [recipeRevisionId], references: [id], onDelete: Restrict)
  createdAt          DateTime               @default(now())
}

model AssemblyRenderIntent {
  id                       String                  @id @db.Uuid
  projectId                String                  @db.Uuid
  project                  Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceId                 String                  @db.Uuid
  source                   VideoSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion            Int
  cutPipelineJobId         String                  @db.Uuid
  cutPipelineJob           PipelineJob             @relation("AssemblyRenderCutJob", fields: [cutPipelineJobId, projectId, sourceId, sourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "AssemblyRenderIntent_exact_cut_job")
  cutResultArtifactId      String                  @db.Uuid
  cutResultArtifact        MediaArtifact           @relation(fields: [cutResultArtifactId, projectId, sourceId, sourceVersion, cutPipelineJobId], references: [id, projectId, lineageSourceId, lineageSourceVersion, pipelineJobId], onDelete: Restrict, map: "AssemblyRenderIntent_exact_cut_artifact")
  cutResultSha256          String
  cutResultSizeBytes       BigInt
  cutResultRecipeVersion   String
  assemblyRecipeId         String                  @db.Uuid
  assemblyRecipe           AssemblyRecipe          @relation(fields: [assemblyRecipeId], references: [id], onDelete: Restrict)
  recipeRevisionId         String                  @db.Uuid
  recipeRevisionRecord     AssemblyRecipeRevision  @relation(fields: [recipeRevisionId, assemblyRecipeId, recipeRevision], references: [id, recipeId, revision], onDelete: Restrict, map: "AssemblyRenderIntent_exact_recipe_revision")
  recipeRevision           Int
  configurationFingerprint String
  renderContractVersion    String                  @default("horizontal-render-v1")
  audioProfileVersion      String
  encodingProfileVersion   String
  expectedDurationMs       Int
  createdAt                DateTime                @default(now())
  pipelineJob              PipelineJob?            @relation("AssemblyRenderJob")
  requests                 AssemblyRenderRequest[]
  result                   AssemblyRenderResult?
  editorialApprovals       EditorialApproval[]

  @@unique([recipeRevisionId, renderContractVersion], map: "AssemblyRenderIntent_revision_contract_key")
  @@unique([id, projectId, sourceId, sourceVersion], map: "AssemblyRenderIntent_exact_lineage_key")
  @@index([projectId, createdAt, id])
}

model AssemblyRenderRequest {
  id                 String               @id @db.Uuid
  idempotencyKey     String               @unique
  requestFingerprint String
  renderIntentId     String               @db.Uuid
  renderIntent       AssemblyRenderIntent @relation(fields: [renderIntentId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
}

model AssemblyRenderResult {
  id                         String                  @id @db.Uuid
  renderIntentId             String                  @unique @db.Uuid
  renderIntent               AssemblyRenderIntent    @relation(fields: [renderIntentId], references: [id], onDelete: Restrict)
  artifactId                 String                  @unique @db.Uuid
  artifact                   MediaArtifact           @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  durationMs                 Int
  width                      Int
  height                     Int
  fpsNumerator               Int
  fpsDenominator             Int
  videoCodec                 String
  pixelFormat                String
  audioCodec                 String
  audioSampleRate            Int
  audioChannels              Int
  ffmpegVersion              String
  ffprobeVersion             String
  integratedLoudnessLufs     Float?
  truePeakDbtp               Float?
  normalizationProfileResult String
  completedAt                DateTime
  createdAt                  DateTime                @default(now())
  editorialApprovals         EditorialApproval[]
  editorialExportIntents     EditorialExportIntent[]

  @@unique([id, renderIntentId, artifactId], map: "AssemblyRenderResult_exact_identity_key")
}

model ProcessingTemplate {
  id                 String                       @id @db.Uuid
  idempotencyKey     String                       @unique
  requestFingerprint String
  createdAt          DateTime                     @default(now())
  revisions          ProcessingTemplateRevision[]
}

model ProcessingTemplateRevision {
  id                   String                     @id @db.Uuid
  templateId           String                     @db.Uuid
  template             ProcessingTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  revision             Int
  name                 String
  configurationVersion String                     @default("manual-editorial-v1")
  createdAt            DateTime                   @default(now())
  editorialRevisions   EditorialPackageRevision[]
  editorialApprovals   EditorialApproval[]

  @@unique([templateId, revision])
  @@index([createdAt, id])
}

model EditorialAsset {
  id                   String                     @id @db.Uuid
  projectId            String                     @db.Uuid
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                 EditorialAssetType
  status               EditorialAssetStatus       @default(PENDING)
  idempotencyKey       String                     @unique
  requestFingerprint   String
  objectKey            String                     @unique
  storageEtag          String?
  storageVersion       String?
  cleanupStatus        ArtifactCleanupStatus      @default(NOT_REQUIRED)
  cleanupAttemptCount  Int                        @default(0)
  cleanupLastErrorCode String?
  cleanupRequestedAt   DateTime?
  cleanupCompletedAt   DateTime?
  failureCode          String?
  failureMessage       String?
  originalFilename     String
  contentType          String
  sizeBytes            BigInt
  sha256               String
  width                Int
  height               Int
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  packageRevisions     EditorialPackageRevision[]
  editorialApprovals   EditorialApproval[]

  @@unique([id, projectId], map: "EditorialAsset_id_projectId_key")
  @@index([projectId, type, status, createdAt])
  @@index([cleanupStatus, updatedAt])
}

model EditorialPackage {
  id                     String                     @id @db.Uuid
  projectId              String                     @db.Uuid
  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipelineJobId          String                     @unique @db.Uuid
  pipelineJob            PipelineJob                @relation(fields: [pipelineJobId], references: [id], onDelete: Restrict)
  cutResultArtifactId    String                     @unique @db.Uuid
  cutResultArtifact      MediaArtifact              @relation(fields: [cutResultArtifactId], references: [id], onDelete: Restrict)
  cutResultSha256        String
  cutResultSizeBytes     BigInt
  cutResultRecipeVersion String
  lineageSourceId        String                     @db.Uuid
  lineageSourceVersion   Int
  currentRevision        Int
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  revisions              EditorialPackageRevision[]
  editorialApprovals     EditorialApproval[]

  @@index([projectId, updatedAt, id])
}

model EditorialPackageRevision {
  id                           String                         @id @db.Uuid
  packageId                    String                         @db.Uuid
  package                      EditorialPackage               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  revision                     Int
  processingTemplateRevisionId String                         @db.Uuid
  processingTemplateRevision   ProcessingTemplateRevision     @relation(fields: [processingTemplateRevisionId], references: [id], onDelete: Restrict)
  title                        String?
  description                  String?
  tags                         Json?
  thumbnailAssetId             String?                        @db.Uuid
  thumbnailAsset               EditorialAsset?                @relation(fields: [thumbnailAssetId], references: [id], onDelete: Restrict)
  createdAt                    DateTime                       @default(now())
  mutationRequests             EditorialMutationRequest[]
  editorialApprovals           EditorialApproval[]
  editorialExportIntents       EditorialExportIntent[]
  componentProvenance          EditorialComponentProvenance[]

  @@unique([packageId, revision])
  @@unique([id, packageId, revision], map: "EditorialPackageRevision_exact_identity_key")
  @@index([processingTemplateRevisionId])
  @@index([thumbnailAssetId])
}

model EditorialMutationRequest {
  id                 String                   @id @db.Uuid
  idempotencyKey     String                   @unique
  requestFingerprint String
  packageRevisionId  String                   @db.Uuid
  packageRevision    EditorialPackageRevision @relation(fields: [packageRevisionId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
}

model EditorialApproval {
  id                           String                      @id @db.Uuid
  projectId                    String                      @db.Uuid
  project                      Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceId                     String                      @db.Uuid
  source                       VideoSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion                Int
  cutPipelineJobId             String                      @db.Uuid
  cutPipelineJob               PipelineJob                 @relation(fields: [cutPipelineJobId, projectId, sourceId, sourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "EditorialApproval_exact_cut_job")
  editorialPackageId           String                      @db.Uuid
  editorialPackage             EditorialPackage            @relation(fields: [editorialPackageId], references: [id], onDelete: Restrict)
  editorialPackageRevisionId   String                      @db.Uuid
  editorialPackageRevision     EditorialPackageRevision    @relation(fields: [editorialPackageRevisionId, editorialPackageId, editorialRevision], references: [id, packageId, revision], onDelete: Restrict, map: "EditorialApproval_exact_editorial_revision")
  editorialRevision            Int
  processingTemplateRevisionId String                      @db.Uuid
  processingTemplateRevision   ProcessingTemplateRevision  @relation(fields: [processingTemplateRevisionId], references: [id], onDelete: Restrict)
  thumbnailAssetId             String                      @db.Uuid
  thumbnailAsset               EditorialAsset              @relation(fields: [thumbnailAssetId, projectId], references: [id, projectId], onDelete: Restrict, map: "EditorialApproval_exact_thumbnail_project")
  thumbnailSha256              String
  thumbnailSizeBytes           BigInt
  thumbnailContentType         String
  assemblyRecipeId             String                      @db.Uuid
  assemblyRecipe               AssemblyRecipe              @relation(fields: [assemblyRecipeId], references: [id], onDelete: Restrict)
  recipeRevisionId             String                      @db.Uuid
  recipeRevisionRecord         AssemblyRecipeRevision      @relation(fields: [recipeRevisionId, assemblyRecipeId, recipeRevision], references: [id, recipeId, revision], onDelete: Restrict, map: "EditorialApproval_exact_recipe_revision")
  recipeRevision               Int
  configurationFingerprint     String
  assemblyRenderIntentId       String                      @db.Uuid
  assemblyRenderIntent         AssemblyRenderIntent        @relation(fields: [assemblyRenderIntentId, projectId, sourceId, sourceVersion], references: [id, projectId, sourceId, sourceVersion], onDelete: Restrict, map: "EditorialApproval_exact_render_intent")
  assemblyRenderResultId       String                      @db.Uuid
  assemblyRenderResult         AssemblyRenderResult        @relation(fields: [assemblyRenderResultId, assemblyRenderIntentId, renderArtifactId], references: [id, renderIntentId, artifactId], onDelete: Restrict, map: "EditorialApproval_exact_render_result")
  renderArtifactId             String                      @db.Uuid
  renderArtifact               MediaArtifact               @relation(fields: [renderArtifactId], references: [id], onDelete: Restrict)
  renderArtifactSha256         String
  renderArtifactSizeBytes      BigInt
  renderContractVersion        String
  approvalContractVersion      String                      @default("manual-horizontal-approval-v1")
  candidateFingerprint         String
  approvedAt                   DateTime                    @default(now())
  metrics                      EditorialApprovalMetrics?
  operationRequests            EditorialOperationRequest[]
  exportIntents                EditorialExportIntent[]

