{
  "components": {
    "schemas": {
      "ArtifactResponseDto": {
        "properties": {
          "contentType": {
            "example": "video/mp4",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lineageSourceId": {
            "format": "uuid",
            "type": "string"
          },
          "lineageSourceVersion": {
            "example": 1,
            "type": "number"
          },
          "recipeVersion": {
            "example": "source-ingest-v1",
            "type": "string"
          },
          "role": {
            "enum": ["SOURCE"],
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sizeBytes": {
            "description": "Decimal string for bigint safety.",
            "example": "123456",
            "type": "string"
          },
          "status": {
            "enum": ["PENDING", "READY", "FAILED_FINAL"],
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "status",
          "sizeBytes",
          "sha256",
          "contentType",
          "lineageSourceId",
          "lineageSourceVersion",
          "recipeVersion"
        ],
        "type": "object"
      },
      "AttestSourceAuthorizationDto": {
        "properties": {
          "attested": {
            "enum": [true],
            "type": "boolean"
          },
          "declarationVersion": {
            "enum": ["source-authorization-v1"],
            "type": "string"
          },
          "expectedRevision": {
            "minimum": 1,
            "type": "number"
          },
          "sourceVersion": {
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "sourceVersion",
          "expectedRevision",
          "declarationVersion",
          "attested"
        ],
        "type": "object"
      },
      "CreateCutsDto": {
        "properties": {
          "segments": {
            "items": {
              "$ref": "#/components/schemas/CutSegmentDto"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["segments"],
        "type": "object"
      },
      "CreateCutsResponseDto": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/PipelineJobResponseDto"
            },
            "type": "array"
          },
          "projectId": {
            "format": "uuid",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["requestId", "projectId", "jobs"],
        "type": "object"
      },
      "CreateProjectUploadDto": {
        "properties": {
          "file": {
            "format": "binary",
            "type": "string"
          },
          "name": {
            "example": "First source",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "rightsConfirmed": {
            "deprecated": true,
            "description": "Ignored legacy upload field. Authorization is a separate step.",
            "enum": ["true"],
            "type": "string"
          }
        },
        "required": ["name", "file"],
        "type": "object"
      },
      "CutJobCountsDto": {
        "properties": {
          "failed": {
            "example": 1,
            "type": "number"
          },
          "ready": {
            "example": 2,
            "type": "number"
          },
          "total": {
            "example": 5,
            "type": "number"
          }
        },
        "required": ["total", "ready", "failed"],
        "type": "object"
      },
      "CutSegmentDto": {
        "properties": {
          "clientSegmentId": {
            "format": "uuid",
            "type": "string"
          },
          "endMs": {
            "minimum": 1,
            "type": "number"
          },
          "startMs": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": ["clientSegmentId", "startMs", "endMs"],
        "type": "object"
      },
      "ErrorDetailDto": {
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_FAILED",
              "IDEMPOTENCY_KEY_INVALID",
              "FILE_REQUIRED",
              "INVALID_MULTIPART",
              "IDEMPOTENCY_CONFLICT",
              "UPLOAD_TOO_LARGE",
              "INVALID_MP4",
              "PROJECT_NOT_FOUND",
              "INVALID_CURSOR",
              "INTERNAL_ERROR",
              "DATABASE_FINALIZE_FAILED",
              "STORAGE_UPLOAD_FAILED"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "FailureResponseDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "type": "object"
      },
      "JobFailureDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": ["code", "message", "retryable"],
        "type": "object"
      },
      "JobResultDto": {
        "properties": {
          "downloadUrl": {
            "format": "uri-reference",
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sizeBytes": {
            "description": "Decimal bigint string.",
            "type": "string"
          }
        },
        "required": ["filename", "sizeBytes", "sha256", "downloadUrl"],
        "type": "object"
      },
      "PipelineJobResponseDto": {
        "properties": {
          "attempt": {
            "type": "number"
          },
          "clientSegmentId": {
            "format": "uuid",
            "type": "string"
          },
          "endMs": {
            "type": "number"
          },
          "failure": {
            "$ref": "#/components/schemas/JobFailureDto"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "processedMs": {
            "type": "number"
          },
          "result": {
            "$ref": "#/components/schemas/JobResultDto"
          },
          "retryBudget": {
            "type": "number"
          },
          "revision": {
            "type": "number"
          },
          "startMs": {
            "type": "number"
          },
          "state": {
            "enum": [
              "QUEUED",
              "PROCESSING",
              "RETRY_WAIT",
              "READY",
              "FAILED_FINAL"
            ],
            "type": "string"
          },
          "totalMs": {
            "type": "number"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "clientSegmentId",
          "revision",
          "state",
          "startMs",
          "endMs",
          "attempt",
          "retryBudget",
          "updatedAt"
        ],
        "type": "object"
      },
      "ProjectCutJobsResponseDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PipelineJobResponseDto"
            },
            "type": "array"
          }
        },
        "required": ["items"],
        "type": "object"
      },
      "ProjectLibraryItemDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "cutJobCounts": {
            "$ref": "#/components/schemas/CutJobCountsDto"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ProjectLibrarySourceDto"
          },
          "status": {
            "enum": ["SOURCE_PENDING", "SOURCE_READY", "FAILED_FINAL"],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt",
          "source",
          "cutJobCounts"
        ],
        "type": "object"
      },
      "ProjectLibraryPageDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectLibraryItemDto"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Opaque cursor for the next page, or null on the last page.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": ["items", "nextCursor"],
        "type": "object"
      },
      "ProjectLibrarySourceDto": {
        "properties": {
          "addedAt": {
            "description": "When the source was added to the media library.",
            "format": "date-time",
            "type": "string"
          },
          "authorization": {
            "$ref": "#/components/schemas/SourceAuthorizationResponseDto"
          },
          "contentType": {
            "example": "video/mp4",
            "type": "string"
          },
          "durationMs": {
            "example": 7200000,
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "originalFilename": {
            "type": "string"
          },
          "probeState": {
            "enum": [
              "QUEUED",
              "PROCESSING",
              "RETRY_WAIT",
              "READY",
              "FAILED_FINAL"
            ],
            "type": "string"
          },
          "sizeBytes": {
            "description": "Decimal string for bigint safety.",
            "example": "123456",
            "type": "string"
          },
          "sourceVersion": {
            "minimum": 1,
            "type": "number"
          },
          "status": {
            "enum": ["PENDING", "READY", "FAILED_FINAL"],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "sourceVersion",
          "addedAt",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "authorization"
        ],
        "type": "object"
      },
      "ProjectResponseDto": {
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/ArtifactResponseDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "failure": {
            "$ref": "#/components/schemas/FailureResponseDto"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rights": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RightsResponseDto"
              }
            ],
            "deprecated": true,
            "nullable": true,
            "type": "object"
          },
          "source": {
            "$ref": "#/components/schemas/SourceResponseDto"
          },
          "status": {
            "enum": ["SOURCE_PENDING", "SOURCE_READY", "FAILED_FINAL"],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt",
          "source",
          "artifact"
        ],
        "type": "object"
      },
      "RightsResponseDto": {
        "properties": {
          "confirmedAt": {
            "format": "date-time",
            "type": "string"
          },
          "declarationVersion": {
            "example": "upload-rights-v1",
            "type": "string"
          }
        },
        "required": ["confirmedAt", "declarationVersion"],
        "type": "object"
      },
      "SourceAuthorizationResponseDto": {
        "properties": {
          "basis": {
            "enum": [
              "LEGACY_ATTESTATION",
              "OPERATOR_ATTESTATION",
              "LOCAL_DEVELOPMENT_AUTO"
            ],
            "type": "string"
          },
          "decidedAt": {
            "format": "date-time",
            "type": "string"
          },
          "declarationVersion": {
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "number"
          },
          "sourceVersion": {
            "minimum": 1,
            "type": "number"
          },
          "status": {
            "enum": ["NOT_REVIEWED", "CLEARED"],
            "type": "string"
          },
          "usable": {
            "description": "Policy-aware authorization eligibility for playback and processing.",
            "type": "boolean"
          }
        },
        "required": ["sourceVersion", "status", "usable", "revision"],
        "type": "object"
      },
      "SourceResponseDto": {
        "properties": {
          "authorization": {
            "$ref": "#/components/schemas/SourceAuthorizationResponseDto"
          },
          "contentType": {
            "example": "video/mp4",
            "type": "string"
          },
          "durationMs": {
            "description": "Authoritative FFprobe duration in integer milliseconds.",
            "example": 7200000,
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "originalFilename": {
            "type": "string"
          },
          "probeFailure": {
            "$ref": "#/components/schemas/FailureResponseDto"
          },
          "probeState": {
            "enum": [
              "QUEUED",
              "PROCESSING",
              "RETRY_WAIT",
              "READY",
              "FAILED_FINAL"
            ],
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sizeBytes": {
            "description": "Decimal string for bigint safety.",
            "example": "123456",
            "type": "string"
          },
          "sourceVersion": {
            "example": 1,
            "type": "number"
          },
          "status": {
            "enum": ["PENDING", "READY", "FAILED_FINAL"],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "sourceVersion",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "sha256",
          "authorization"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Private Content Factory REST API",
    "title": "Content Factory API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["App"]
      }
    },
    "/api/v1/pipeline-jobs/{id}": {
      "get": {
        "operationId": "MediaPipelineController_job",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineJobResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": ["media-pipeline"]
      }
    },
    "/api/v1/pipeline-jobs/{id}/result": {
      "get": {
        "operationId": "MediaPipelineController_result",
        "parameters": [
          {
            "description": "One RFC 9110 byte range, for example bytes=0-1048575.",
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "video/mp4": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Ready cut result MP4 attachment.",
            "headers": {
              "Accept-Ranges": {
                "description": "Supported range unit.",
                "schema": {
                  "example": "bytes",
                  "type": "string"
                }
              }
            }
          },
          "206": {
            "content": {
              "video/mp4": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Requested cut-result byte range.",
            "headers": {
              "Accept-Ranges": {
                "description": "Supported range unit.",
                "schema": {
                  "example": "bytes",
                  "type": "string"
                }
              },
              "Content-Range": {
                "description": "Returned or unsatisfied byte range.",
                "schema": {
                  "example": "bytes 0-1023/4096",
                  "type": "string"
                }
              }
            }
          },
          "416": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The requested byte range cannot be satisfied.",
            "headers": {
              "Accept-Ranges": {
                "description": "Supported range unit.",
                "schema": {
                  "example": "bytes",
                  "type": "string"
                }
              },
              "Content-Range": {
                "description": "Unsatisfied range with the authoritative object size.",
                "schema": {
                  "example": "bytes */4096",
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": ["media-pipeline"]
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "ProjectsController_list",
        "parameters": [
          {
            "description": "Case-insensitive literal project name or original filename search. Control characters are rejected.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": ["SOURCE_PENDING", "SOURCE_READY", "FAILED_FINAL"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 20,
              "maximum": 50,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectLibraryPageDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid cursor, limit, status, or search query."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Internal query failure."
          }
        },
        "summary": "List source projects for the media library",
        "tags": ["projects"]
      },
      "post": {
        "operationId": "ProjectsController_create",
        "parameters": [
          {
            "description": "Unique caller key (8-200 ASCII characters) for this logical upload.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectUploadDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponseDto"
                }
              }
            },
            "description": "Created project, or the existing project in its current PENDING, READY, or FAILED state for an identical idempotent retry."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid fields, rights, file, multipart body, or idempotency key."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The key belongs to a different payload."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Upload exceeds the configured limit."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The file is not a structurally acceptable MP4."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Persistence or internal finalization failure."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Object storage upload failed."
          }
        },
        "summary": "Create a project by uploading an MP4 source for later authorization",
        "tags": ["projects"]
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "operationId": "ProjectsController_get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponseDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid project UUID."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Project not found."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Internal query failure."
          }
        },
        "summary": "Get safe source-ingestion status and lineage",
        "tags": ["projects"]
      }
    },
    "/api/v1/projects/{id}/source-authorization": {
      "put": {
        "operationId": "ProjectsController_authorize",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttestSourceAuthorizationDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponseDto"
                }
              }
            },
            "description": ""
          },
