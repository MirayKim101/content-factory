#!/bin/sh
set -eu

mc alias set --quiet local http://minio:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
mc ready local
mc mb --ignore-existing "local/$S3_SOURCE_BUCKET"
mc anonymous set none "local/$S3_SOURCE_BUCKET"

policy_file=/tmp/content-factory-api-policy.json
cat >"$policy_file" <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::$S3_SOURCE_BUCKET"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::$S3_SOURCE_BUCKET/sources/*"]
    }
  ]
}
EOF

mc admin policy create local content-factory-source-api "$policy_file"
mc admin user add local "$S3_ACCESS_KEY" "$S3_SECRET_KEY"
mc admin policy attach local content-factory-source-api --user "$S3_ACCESS_KEY"
mc anonymous get "local/$S3_SOURCE_BUCKET" | grep -qi private
