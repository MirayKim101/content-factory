{
	admin off
	auto_https off
}

http://:8080 {
	root * /usr/share/caddy
	log {
		output stdout
		format json
	}
	@liveness path /healthz
	handle @liveness {
		respond "ok" 200
	}
	@api path /api/v1 /api/v1/*
	handle @api {
		# API's existing ceiling is 10 GiB. Leave 1 MiB for multipart framing
		# so the application, not the edge, returns its normal JSON 413.
		request_body {
			max_size 10738466816
		}
		reverse_proxy api:3001 {
			header_up -Forwarded
			header_up -X-Forwarded-*
			# No full-body buffers or shortened application deadlines.
			flush_interval -1
			transport http {
				compression off
			}
		}
	}
	@hashedNuxtAsset {
		path /_nuxt/*
		file
	}
	handle @hashedNuxtAsset {
		route {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle /_nuxt/* {
		file_server
	}
	@staticAsset path_regexp staticAsset (?i)\.(?:avif|css|gif|ico|jpe?g|js|map|mjs|png|svg|webp|woff2?)$
	handle @staticAsset {
		file_server
	}
	handle {
		route {
			try_files {path} /index.html
			header {
				Cache-Control "no-store"
				Content-Security-Policy "frame-ancestors 'none'"
				X-Frame-Options DENY
			}
			file_server
		}
	}
}
